            "inputArtifacts": [
              {
                "name": "SourceArtifact"
              }
            ],
            "outputArtifacts": [
              {
                "name": "ContainerArtifact"
              }
            ],
            "configuration": {
              "ProjectName": "phani-devsecops-phase2"
            },
            "runOrder": 1
          }
        ]
